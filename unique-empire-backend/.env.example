# --- Core ---
ENVIRONMENT=development            # development | staging | production
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
DATABASE_URL=sqlite:///.dev.db
POSTGRES_USER=ue
POSTGRES_PASSWORD=ue_password
POSTGRES_DB=unique_empire

# --- Auth / sessions (Architecture section 14 starting values) ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
INACTIVITY_MINUTES=15
OFFLINE_AUTHORIZATION_DAYS=7
COOKIE_SECURE=true                 # set false only for plain-http local development

# --- Devices / closing ---
DEVICE_STALE_HOURS=12

# --- Web ---
CORS_ORIGINS=[]                    # JSON list, e.g. ["https://app.example.com"]; empty when served same-origin through Caddy
DOMAIN=localhost                   # used by Caddy

# --- Rate limits (SlowAPI syntax) ---
LOGIN_RATE_LIMIT=10/minute
DEFAULT_RATE_LIMIT=120/minute

# --- Operations ---
RESTORATION_LOG_PATH=/backup/restoration_log.jsonl   # must live on storage OUTSIDE the database volume
SENTRY_DSN=
RUN_MIGRATIONS_ON_START=true
